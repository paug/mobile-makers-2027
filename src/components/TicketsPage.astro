---
// Standalone, indexable ticketing page (the short link /tickets still redirects to Billetweb).
import { buildModel, LEGAL_PAGES } from '../i18n/model';
import type { Lang } from '../i18n/copy';
import Layout from './Layout.astro';
import Tickets from './sections/Tickets.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const m = buildModel(lang, { fr: LEGAL_PAGES.fr.tickets, en: LEGAL_PAGES.en.tickets });

const C = {
  fr: {
    title: 'Billetterie Mobile Makers 2027 · Conférence Android Paris',
    description: 'Votre billet pour Mobile Makers, la conférence Android et Flutter du 30 avril 2027 à Paris : Early bird, Regular, Late bird, billet transférable.',
    h1: 'Billetterie Mobile Makers 2027',
    intro: "Mobile Makers est la conférence dédiée au développement mobile Android et Flutter, organisée par la communauté PAUG le 30 avril 2027 à l'UGC Ciné Cité Bercy, à Paris. Une journée, 4 tracks et plus de 400 makers : réservez votre place sur Billetweb.",
    moreTitle: 'Bon à savoir sur les billets',
    more: [
      "Trois tarifs se succèdent : Early bird (100 € HT, quantité limitée), Regular (200 € HT, après l'Early bird) et Late bird (300 € HT, juste avant l'évènement).",
      "Chaque billet donne accès aux 4 tracks, au replay vidéo des talks, au petit-déjeuner, au déjeuner et aux pauses café, ainsi qu'aux goodies et surprises de la communauté.",
      "Vous achetez pour votre entreprise ? Une facture est générée à la commande.",
      "Votre billet est transférable à tout moment, et le nombre de places est limité.",
      "Vous souhaitez parler plutôt qu'écouter ? Les speakers reçoivent leur billet : découvrez l'appel à talks.",
    ],
    cfp: "Proposer un talk", cfpHref: '/appel-a-talks/',
    faq: 'Une question ? Consultez la FAQ', faqHref: '/faq/',
  },
  en: {
    title: 'Mobile Makers 2027 tickets · Android and Flutter, Paris',
    description: 'Get your ticket for Mobile Makers, the Android and Flutter conference on April 30, 2027 in Paris: Early bird, Regular and Late bird, transferable tickets.',
    h1: 'Mobile Makers 2027 tickets',
    intro: 'Mobile Makers is the conference dedicated to Android and Flutter mobile development, organised by the PAUG community on April 30, 2027 at UGC Ciné Cité Bercy in Paris. One day, 4 tracks and 400+ makers: book your seat on Billetweb.',
    moreTitle: 'Good to know about tickets',
    more: [
      'Three tiers follow one another: Early bird (€100 excl. VAT, limited quantity), Regular (€200 excl. VAT, after the Early bird) and Late bird (€300 excl. VAT, right before the event).',
      'Every ticket includes access to the 4 tracks, the video replay of the talks, breakfast, lunch and coffee breaks, plus goodies and community surprises.',
      'Buying for your company? An invoice is generated with your order.',
      'Your ticket is transferable at any time, and seats are limited.',
      'Would you rather speak than listen? Speakers get their ticket: see the call for papers.',
    ],
    cfp: 'Submit a talk', cfpHref: '/en/call-for-papers/',
    faq: 'Questions? Read the FAQ', faqHref: '/en/faq/',
  },
}[lang];
---
<Layout m={m} title={C.title} description={C.description}>
  <header class="mm-wrap" style="padding-top:clamp(48px,6vw,80px)">
    <div style="display:flex;flex-direction:column;gap:20px;max-width:820px">
      <div class="mm-eyebrow">{m.t.ticketsEyebrow}</div>
      <h1 class="mm-h2" style="margin:0;color:var(--ink-1);font-size:clamp(32px,4.6vw,56px);font-weight:600">{C.h1}</h1>
      <p style="margin:0;font:400 19px/1.5 var(--font-body);color:var(--ink-2);text-wrap:pretty">{C.intro}</p>
    </div>
  </header>
  <Tickets m={m} />
  <section class="mm-wrap" style="padding-top:64px;padding-bottom:clamp(48px,6vw,80px)">
    <div style="display:flex;flex-direction:column;gap:16px;max-width:820px">
      <h2 style="margin:0;color:var(--ink-1);font:600 clamp(24px,3vw,32px)/1.2 var(--font-display)">{C.moreTitle}</h2>
      <ul style="margin:0;padding-left:20px;display:grid;gap:10px;font:400 17px/1.5 var(--font-body);color:var(--ink-1)">
        {C.more.map((x) => <li>{x}</li>)}
      </ul>
      <p style="margin:0;display:flex;gap:24px;flex-wrap:wrap"><a href={C.cfpHref} class="mm-textlink">{C.cfp}</a><a href={C.faqHref} class="mm-textlink">{C.faq}</a></p>
    </div>
  </section>
</Layout>

---
// Image slot: shows `src` when provided, otherwise a labelled placeholder.
// `width`/`height` are the image's intrinsic size, so the browser reserves the space before it loads (no layout shift).
interface Props { src?: string; alt?: string; placeholder: string; width?: number; height?: number }
const { src, alt = '', placeholder, width, height } = Astro.props;
---
<div class="mm-slot">{src ? <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" /> : <span>{placeholder}</span>}</div>

---
// Section headline. The scroll-driven weight of the prototype is dropped: Gill Sans only ships static cuts.
// The vertical margin reproduces the spacing the design prototype gives every ScrollTitle.
interface Props { as?: 'h1' | 'h2'; class?: string; style?: string }
const { as: Tag = 'h2', class: cls, style = '' } = Astro.props;
---
<Tag class:list={['mm-scroll-title', cls]} style={`margin:${Tag === 'h1' ? 23 : 21}px 0;${style}`}><slot /></Tag>

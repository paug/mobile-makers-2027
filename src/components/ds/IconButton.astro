---
import Icon from './Icon.astro';
interface Props { icon: string; label: string; href?: string; variant?: 'secondary' | 'ghost'; size?: 'sm' | 'md'; [k: string]: unknown }
const { icon, label, href, variant = 'secondary', size = 'md', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag class:list={['mm-iconbtn', variant === 'ghost' && 'mm-iconbtn--ghost', size === 'sm' && 'mm-iconbtn--sm']} href={href} aria-label={label} title={label} {...rest}>
  <Icon name={icon} size={size === 'sm' ? 16 : 20} />
</Tag>

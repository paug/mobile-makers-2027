---
// Speaker tile built on FoldedCard: square duotone photo (or initials) on a hue, a company tab cut into the photo corner,
// then name, role and topic tags.
import FoldedCard from './FoldedCard.astro';
import FoldedCardInsetLabel from './FoldedCardInsetLabel.astro';
import FoldedCardMedia from './FoldedCardMedia.astro';
import Tag from './Tag.astro';
interface Props { name: string; role: string; company?: string; topics?: readonly string[]; photo?: string; hue?: string }
const { name, role, company, topics = [], photo, hue = 'cyan' } = Astro.props;
const H = ['cyan', 'red', 'green'].includes(hue) ? hue : 'cyan';
const initials = name.split(' ').map((w) => w[0]).join('').slice(0, 2);
---
<FoldedCard foldSize={40} label={name}>
  <FoldedCardMedia ratio="1 / 1">
    <div aria-hidden="true" style={`position:absolute;inset:0;background:var(--${H})`}></div>
    {photo
      ? <img src={photo} alt={name} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;filter:grayscale(1) contrast(1.05);mix-blend-mode:multiply" />
      : <div aria-hidden="true" style={`position:absolute;inset:0;display:grid;place-items:center;font:500 72px/1 var(--font-display);letter-spacing:-0.02em;color:${H === 'red' ? 'rgba(255,255,255,.95)' : 'var(--ink-1)'}`}>{initials}</div>}
    <div aria-hidden="true" style="position:absolute;inset:0;background-image:var(--fold-shade);pointer-events:none"></div>
    {company && <FoldedCardInsetLabel>{company.toUpperCase()}</FoldedCardInsetLabel>}
  </FoldedCardMedia>
  <div style="padding:var(--space-4);display:grid;gap:8px;flex:1">
    <h3 style="margin:0;font:var(--type-h4);letter-spacing:var(--tracking-tight);color:var(--ink-1)">{name}</h3>
    {role && <div style="font:var(--type-body-sm);color:var(--text-secondary)">{role}</div>}
    {topics.length > 0 && <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:4px">{topics.map((t) => <Tag style="height:24px;font-size:12px">{t}</Tag>)}</div>}
  </div>
</FoldedCard>

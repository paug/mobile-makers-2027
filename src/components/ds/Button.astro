---
import Icon from './Icon.astro';
interface Props {
  href?: string; variant?: 'primary' | 'accent' | 'secondary' | 'inverse' | 'ghost'; size?: 'sm' | 'md' | 'lg';
  icon?: string; iconRight?: string; fullWidth?: boolean; disabled?: boolean; target?: string; class?: string; [k: string]: unknown;
}
const { href, variant = 'primary', size = 'md', icon, iconRight, fullWidth, disabled, class: cls, ...rest } = Astro.props;
const classes = ['mm-btn', `mm-btn--${variant}`, size !== 'md' && `mm-btn--${size}`, fullWidth && 'mm-btn--full', cls];
const isz = size === 'sm' ? 16 : size === 'lg' ? 22 : 18;
const Tag = href && !disabled ? 'a' : 'button';
// mailto: with target=_blank opens an empty tab in some browsers, so only http(s) links open in a new tab
if (rest.target === '_blank' && !String(href ?? '').startsWith('http')) delete rest.target;
const ext = rest.target === '_blank' ? { rel: 'noopener noreferrer' } : {};
---
<Tag class:list={classes} href={Tag === 'a' ? href : undefined} disabled={Tag === 'button' ? disabled : undefined} {...ext} {...rest}>
  {icon && <Icon name={icon} size={isz} />}<slot />{iconRight && <Icon name={iconRight} size={isz} />}
</Tag>

---
// Text page (legal notice, privacy, code of conduct). The slot holds the prose.
import { buildModel, LEGAL_PAGES, type LegalKey } from '../i18n/model';
import type { Lang } from '../i18n/copy';
import Layout from './Layout.astro';

interface Props { lang: Lang; page: LegalKey; eyebrow: string; title: string; description: string; updated: string }
const { lang, page, eyebrow, title, description, updated } = Astro.props;
const m = buildModel(lang, { fr: LEGAL_PAGES.fr[page], en: LEGAL_PAGES.en[page] });
const updatedLabel = lang === 'fr' ? 'Dernière mise à jour : ' : 'Last updated: ';
---
<Layout m={m} title={`${title} · Mobile Makers 2027`} description={description}>
  <article class="mm-wrap" style="padding-top:clamp(48px,6vw,80px);padding-bottom:clamp(48px,6vw,80px)">
    <div style="display:flex;flex-direction:column;gap:12px;max-width:720px;margin-bottom:40px">
      <div class="mm-eyebrow">{eyebrow}</div>
      <h1 class="mm-h2" style="margin:0;color:var(--ink-1);font-size:clamp(36px,5vw,64px);font-weight:600">{title}</h1>
      <p style="margin:0;font:500 14px/1.4 var(--font-mono);color:var(--ink-3)">{updatedLabel}{updated}</p>
    </div>
    <div class="mm-prose">
      <slot />
    </div>
  </article>
</Layout>

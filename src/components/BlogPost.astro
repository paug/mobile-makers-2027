---
// One blog post. The language switch goes to the translation with the same slug, or to the other blog home if there is none.
import { getEntry, render } from 'astro:content';
import { buildModel } from '../i18n/model';
import type { Lang } from '../i18n/copy';
import Layout from './Layout.astro';
import { blogHome, formatDate, postHref, postSlug, type Post } from './blog';

interface Props { lang: Lang; post: Post }
const { lang, post } = Astro.props;
const slug = postSlug(post);
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const translated = await getEntry('blog', `${other}/${slug}`);
const hrefs = { [lang]: postHref(lang, slug), [other]: translated ? postHref(other, slug) : blogHome(other) } as Record<Lang, string>;
const m = buildModel(lang, hrefs);
const { Content } = await render(post);
const back = lang === 'fr' ? '← Tous les articles' : '← All posts';
---
<Layout m={m} title={`${post.data.title} · Mobile Makers 2027`} description={post.data.description}>
  <article class="mm-wrap" style="padding-top:clamp(48px,6vw,80px);padding-bottom:clamp(48px,6vw,80px)">
    <div style="display:flex;flex-direction:column;gap:12px;max-width:720px;margin-bottom:40px">
      <a class="mm-eyebrow" href={blogHome(lang)} style="text-decoration:none">{back}</a>
      <h1 class="mm-h2" style="margin:0;color:var(--ink-1);font-size:clamp(36px,5vw,64px);font-weight:600">{post.data.title}</h1>
      {post.data.subtitle && <p style="margin:0;font:600 26px/1.15 var(--font-display);color:var(--ink-2);text-wrap:balance">{post.data.subtitle}</p>}
      <time datetime={post.data.date.toISOString().slice(0, 10)} style="font:500 14px/1.4 var(--font-mono);color:var(--ink-3)">{formatDate(lang, post.data.date)}</time>
    </div>
    <div class="mm-prose">
      <Content />
    </div>
  </article>
</Layout>

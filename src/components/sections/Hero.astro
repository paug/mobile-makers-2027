---
import Button from '../ds/Button.astro';
import Fold from '../ds/Fold.astro';
import ScrollTitle from '../ds/ScrollTitle.astro';
import type { Model } from '../../i18n/model';
const { m } = Astro.props as { m: Model };
const { t } = m;
---
<section id="event" class="mm-section" style="position:relative;overflow:hidden;background:var(--graphite);color:var(--paper-1)">
  <div style="max-width:1200px;margin:0 auto;padding:clamp(56px,7vw,96px) 24px clamp(56px,6vw,80px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,520px),1fr));gap:40px;align-items:center;position:relative;z-index:1">
    <div style="display:flex;flex-direction:column;gap:28px;min-width:0">
      <div class="mm-eyebrow" style="color:var(--cyan-light)">{t.heroEyebrow}</div>
      <ScrollTitle as="h1" mode="leave"><span style="display:block;font-family:var(--font-display);font-size:clamp(42px,6vw,84px);line-height:1;letter-spacing:-0.01em;color:var(--paper-1);text-wrap:balance">{t.heroTitle}</span></ScrollTitle>
      <p style="margin:0;font:400 clamp(18px,1.6vw,21px)/1.5 var(--font-body);color:var(--paper-3);max-width:52ch;text-wrap:pretty">{t.heroSub}</p>
      <div style="display:flex;gap:14px;flex-wrap:wrap">
        <Button href="#tickets" size="lg" iconRight="arrow-right">{t.ctaTicket}</Button>
        <Button href="#cfp" size="lg" variant="accent">{t.ctaTalk}</Button>
      </div>
      <dl style="margin:0;display:flex;flex-wrap:wrap;gap:12px 32px;padding-top:12px;border-top:1px solid rgba(255,255,255,.1)">
        {m.heroFacts.map((f) => (
          <div style="display:flex;align-items:baseline;gap:8px"><dt style="font:700 28px/1 var(--font-display-condensed);color:var(--cyan-light)">{f.n}</dt><dd style="margin:0;font:500 15px/1.2 var(--font-display);color:var(--paper-3)">{f.l}</dd></div>
        ))}
      </dl>
    </div>
    <div aria-hidden="true" class="hidden desk:block" style="position:relative;height:440px;min-width:0">
      <Fold shape="crane" hue="cyan" size={300} style="position:absolute;left:60px;top:10px" />
      <Fold shape="kite" hue="red" size={180} crease="diagonal" style="position:absolute;left:0;top:250px" />
      <Fold shape="shard" hue="green" size={130} crease="horizontal" rotate={180} style="position:absolute;right:30px;top:0" />
      <Fold shape="hexafold" hue="var(--blue)" size={120} style="position:absolute;right:0;bottom:30px" />
      <Fold shape="crane" hue="cyan" size={80} rotate={180} style="position:absolute;left:270px;bottom:0" />
    </div>
  </div>
  <div aria-hidden="true" style="position:absolute;left:-10%;right:-10%;bottom:-40%;height:60%;background:radial-gradient(ellipse at 30% 100%, rgba(32,184,232,.22), transparent 60%), radial-gradient(ellipse at 75% 100%, rgba(232,64,44,.18), transparent 55%);pointer-events:none"></div>
</section>

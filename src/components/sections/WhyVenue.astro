---
import Button from '../ds/Button.astro';
import Fold from '../ds/Fold.astro';
import Icon from '../ds/Icon.astro';
import ScrollTitle from '../ds/ScrollTitle.astro';
import Slot from '../ds/Slot.astro';
import type { Model } from '../../i18n/model';
const { m } = Astro.props as { m: Model };
const { t } = m;
---
<div data-reveal style="max-width:1200px;margin:0 auto;padding:clamp(64px,7vw,96px) 24px 0">
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,165px),1fr));gap:16px">
    {m.why.map((w) => (
      <div class="mm-why" style="position:relative;background:var(--paper-0);border:1px solid var(--border-subtle);box-shadow:var(--shadow-fold-sm);display:flex;flex-direction:column;clip-path:polygon(0 0,calc(100% - 28px) 0,100% 28px,100% 100%,0 100%)">
        <div aria-hidden="true" style="position:absolute;top:0;right:0;width:28px;height:28px;background:linear-gradient(225deg,var(--paper-3) 0 50%,var(--paper-2) 50% 100%);clip-path:polygon(0 0,100% 100%,0 100%);z-index:2"></div>
        <div style={`position:relative;height:clamp(130px,13vw,160px);overflow:hidden;background:${w.bg};background-image:linear-gradient(115deg,rgba(255,255,255,.26) 0 46%,rgba(40,40,40,.18) 46% 100%)`}>
          <Fold shape={w.shape} hue={w.foldHue} size={170} crease="diagonal" style="position:absolute;right:-30px;top:-36px" />
          <div style="position:absolute;left:0;bottom:0;background:var(--paper-0);padding:6px 34px 2px 24px;clip-path:polygon(0 0,calc(100% - 20px) 0,100% 20px,100% 100%,0 100%)">
            <span style={`display:block;font:700 clamp(36px,3.4vw,48px)/.88 var(--font-display-condensed);letter-spacing:-0.02em;color:${w.ink}`}>{w.n}</span>
          </div>
        </div>
        <div style="padding:20px 20px 24px;display:flex;flex-direction:column;gap:8px;flex:1;min-width:0">
          <h3 style="margin:0;font:600 clamp(20px,1.7vw,24px)/1.12 var(--font-display);letter-spacing:-0.01em;color:var(--ink-1);text-wrap:balance">{w.title}</h3>
          <p style="margin:0;font:400 16px/1.5 var(--font-body);color:var(--ink-2);text-wrap:pretty">{w.body}</p>
        </div>
      </div>
    ))}
  </div>
</div>

<div data-reveal style="max-width:1200px;margin:clamp(64px,7vw,96px) auto 0;padding:0 24px">
  <div style="background:var(--paper-2);padding:clamp(32px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:40px;align-items:start">
    <div style="display:flex;flex-direction:column;gap:20px;min-width:0">
      <div class="mm-eyebrow">{t.venueEyebrow}</div>
      <ScrollTitle><span style="display:block;font-family:var(--font-display);font-size:clamp(34px,5vw,64px);line-height:1;letter-spacing:-0.01em;color:var(--ink-1);text-wrap:balance">{t.venueTitle}</span></ScrollTitle>
      <p style="margin:0;font:400 19px/1.5 var(--font-body);color:var(--ink-2);text-wrap:pretty">{t.venueLead}</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,140px),1fr));gap:20px 24px;padding:8px 0">
        {m.venueStats.map((s) => <div style="display:flex;flex-direction:column;gap:4px"><span style="font:700 56px/1 var(--font-display-condensed);color:var(--red)">{s.n}</span><span style="font:400 15px/1.3 var(--font-body);color:var(--ink-2)">{s.l}</span></div>)}
      </div>
      <div style="display:flex;flex-direction:column;gap:14px;font:400 16px/1.5 var(--font-body);color:var(--ink-1)">
        {m.venueRows.map((r) => <div style="display:flex;gap:12px;align-items:flex-start"><Icon name={r.icon} size={20} color="var(--cyan-dark)" style="margin-top:3px" /><span>{r.text}</span></div>)}
      </div>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <Button href={m.L.mapsUrl} target="_blank" variant="inverse" icon="map-pin">{t.venueBtn}</Button>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:minmax(0,1fr);gap:16px;min-width:0">
      <div style="position:relative;aspect-ratio:4/3;background:var(--paper-3);width:100%;overflow:hidden"><Slot placeholder={t.venuePhoto} /></div>
      <div style="position:relative;aspect-ratio:16/7;background:var(--surface-container);display:grid;place-items:center;text-align:center;padding:16px" class="mm-eyebrow">{t.venueMap}</div>
    </div>
  </div>
</div>

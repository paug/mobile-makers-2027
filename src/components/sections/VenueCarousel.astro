---
// Venue photo carousel: a scroll-snap track (swipe and keyboard scroll work without JS),
// plus prev/next buttons and one progress segment per photo.
import IconButton from '../ds/IconButton.astro';
import type { Model } from '../../i18n/model';
const { m } = Astro.props as { m: Model };
const { t } = m;
const n = m.venueSlides.length;
---
<section class="mm-venue-carousel" aria-roledescription="carousel" aria-label={t.venuePhotos} data-venue-carousel>
  <div class="mm-vc-track" tabindex="0" data-vc-track>
    {m.venueSlides.map((s, i) => (
      <figure class="mm-vc-slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} / ${n}`}>
        <img src={s.src} srcset={`${s.src600} 600w, ${s.src} 1200w`} sizes="(min-width: 900px) 540px, calc(100vw - 48px)" alt={s.caption} width="1200" height="900" loading="lazy" decoding="async" fetchpriority="low" />
        <figcaption>{s.caption}</figcaption>
      </figure>
    ))}
  </div>
  <div class="mm-vc-bar">
    <div class="mm-vc-dots">
      {m.venueSlides.map((s, i) => (
        <button type="button" class="mm-vc-dot" aria-label={s.caption} aria-current={i === 0 ? 'true' : undefined} data-vc-dot={i}></button>
      ))}
    </div>
    <span class="mm-vc-count" aria-hidden="true"><span data-vc-current>01</span> / {String(n).padStart(2, '0')}</span>
    <div style="display:flex;gap:8px">
      <IconButton icon="chevron-left" label={t.venuePrev} size="sm" data-vc-step="-1" />
      <IconButton icon="chevron-right" label={t.venueNext} size="sm" data-vc-step="1" />
    </div>
  </div>
</section>

<style>
  .mm-venue-carousel { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .mm-vc-track {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
    aspect-ratio: 4/3; background: var(--paper-3); scrollbar-width: none;
  }
  .mm-vc-track::-webkit-scrollbar { display: none; }
  .mm-vc-track:focus-visible { outline: 2px solid var(--cyan-dark); outline-offset: 3px; }
  .mm-vc-slide { position: relative; flex: 0 0 100%; margin: 0; scroll-snap-align: start; scroll-snap-stop: always; overflow: hidden; }
  .mm-vc-slide img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .mm-vc-slide figcaption {
    position: absolute; left: 0; bottom: 0; max-width: calc(100% - 24px); background: var(--paper-0);
    padding: 8px 30px 6px 16px; clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 0 100%);
    font: 600 14px/1.3 var(--font-body); color: var(--ink-1);
  }
  .mm-vc-bar { display: flex; align-items: center; gap: 16px; }
  .mm-vc-dots { display: flex; gap: 6px; flex: 1; }
  .mm-vc-dot { flex: 1; height: 24px; padding: 0; border: 0; background: none; cursor: pointer; position: relative; }
  .mm-vc-dot::before {
    content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 4px; transform: translateY(-50%);
    background: var(--border-default); transition: background var(--dur-effect) var(--ease-emphasized);
  }
  .mm-vc-dot:hover::before { background: var(--ink-3); }
  .mm-vc-dot[aria-current='true']::before { background: var(--red); }
  .mm-vc-dot:focus-visible { outline: 2px solid var(--cyan-dark); outline-offset: 2px; }
  .mm-vc-count { font: 600 12px/1 var(--font-mono); letter-spacing: .08em; color: var(--ink-2); font-variant-numeric: tabular-nums; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-venue-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-vc-track]')!;
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-vc-dot]')];
    const current = root.querySelector<HTMLElement>('[data-vc-current]')!;
    const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    const index = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => {
      const next = (i + dots.length) % dots.length; // wrap around at both ends
      track.scrollTo({ left: next * track.clientWidth, behavior: smooth ? 'smooth' : 'auto' });
    };
    const sync = () => {
      const i = index();
      dots.forEach((d, j) => (j === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      current.textContent = String(i + 1).padStart(2, '0');
    };
    track.addEventListener('scroll', sync, { passive: true });
    dots.forEach((d, j) => d.addEventListener('click', () => go(j)));
    root.querySelectorAll<HTMLButtonElement>('[data-vc-step]').forEach((b) =>
      b.addEventListener('click', () => go(index() + Number(b.dataset.vcStep))),
    );
  });
</script>

---
import Badge from '../ds/Badge.astro';
import Card from '../ds/Card.astro';
import Icon from '../ds/Icon.astro';
import ScrollTitle from '../ds/ScrollTitle.astro';
import type { Model } from '../../i18n/model';
const { m } = Astro.props as { m: Model };
const { t } = m;
const tracks = [
  { key: 'android', label: t.trackAndroid, color: 'var(--green-dark)', tagBg: 'var(--green-light)' },
  { key: 'flutter', label: t.trackFlutter, color: 'var(--blue-dark)', tagBg: 'var(--blue-light)' },
] as const;
---
<section id="agenda" class="mm-section" data-track="android" style="padding-top:96px">
  <div class="mm-wrap">
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:40px">
      <div style="display:flex;flex-direction:column;gap:12px;max-width:660px">
        <div class="mm-eyebrow">{t.agendaEyebrow}</div>
        <ScrollTitle><span class="mm-h2" style="color:var(--ink-1)">{t.agendaTitle}</span></ScrollTitle>
      </div>
      <div style="display:flex;gap:10px;align-items:center;background:var(--surface-container-low);padding:12px 16px;max-width:440px;flex:1 1 300px">
        <Icon name="clock" size={18} color="var(--cyan-dark)" />
        <span style="font:400 15px/1.45 var(--font-body);color:var(--ink-2)">{t.agendaNotice}</span>
      </div>
    </div>
    <div class="desk:hidden" style="margin-bottom:20px">
      <div class="mm-tabs" role="tablist">
        {tracks.map((tr, i) => <button type="button" class="mm-tab" role="tab" data-track-tab={tr.key} aria-selected={i === 0 ? 'true' : 'false'}>{tr.label}</button>)}
      </div>
    </div>
    <div style="display:flex;flex-direction:column;border-top:1px solid var(--border-subtle)">
      {m.slots.map((s) => (
        <div style="display:grid;grid-template-columns:minmax(72px,auto) minmax(0,1fr);gap:16px 24px;padding:20px 0;border-bottom:1px solid var(--border-subtle)">
          <div style="display:flex;flex-direction:column;gap:6px;padding-top:2px"><span style={`font:500 15px/1 var(--font-mono);color:${s.color}`}>{s.time}</span><span style={`width:10px;height:10px;background:${s.color}`}></span></div>
          <div style="display:flex;flex-direction:column;gap:14px;min-width:0">
            <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px">
              <h3 style="margin:0;font:600 22px/1.2 var(--font-display);letter-spacing:-0.01em;color:var(--ink-1)">{s.title}</h3>
              <span style={`font:600 12px/1 var(--font-mono);letter-spacing:.08em;text-transform:uppercase;padding:6px 8px;background:${s.tagBg};color:var(--ink-1)`}>{s.tag}</span>
              {s.tbc && <Badge>{t.tbc}</Badge>}
            </div>
            {s.note && <p style="margin:0;font:400 16px/1.5 var(--font-body);color:var(--ink-2)">{s.note}</p>}
            {s.parallel && (
              <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:16px">
                {tracks.map((tr) => (
                  <div class="mm-track" data-track-panel={tr.key} style="flex-direction:column;gap:12px">
                    <div class="mm-label" style={`color:${tr.color}`}>{tr.label}</div>
                    {s[tr.key].map((tk) => (
                      <Card padding="20px">
                        <div style="display:flex;flex-direction:column;gap:10px">
                          <div style="display:flex;flex-wrap:wrap;gap:6px;align-items:center"><span style={`font:600 11px/1 var(--font-mono);letter-spacing:.08em;text-transform:uppercase;padding:5px 7px;background:${tr.tagBg};color:var(--ink-1)`}>{tk.track}</span><Badge>{tk.lang}</Badge><span style="font:500 13px/1 var(--font-mono);color:var(--ink-3);margin-left:auto">{tk.dur}</span></div>
                          <h4 style="margin:0;font:600 19px/1.25 var(--font-display);color:var(--ink-1);text-wrap:pretty">{tk.title}</h4>
                          <div style="font:400 15px/1.4 var(--font-body);color:var(--ink-2)">{tk.speaker}</div>
                        </div>
                      </Card>
                    ))}
                    <a href="#cfp" class="mm-open-slot"><span>{t.slotOpen}</span><Icon name="arrow-right" size={18} /></a>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .mm-track { display: flex; }
  @media (max-width: 1179.98px) {
    [data-track="android"] .mm-track[data-track-panel="flutter"],
    [data-track="flutter"] .mm-track[data-track-panel="android"] { display: none; }
  }
  .mm-open-slot { border: 1.5px dashed var(--border-default); padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; gap: 12px; text-decoration: none; color: var(--cyan-dark); font: 500 16px/1.3 var(--font-display); min-height: 44px; }
  .mm-open-slot:hover { border-color: var(--cyan-dark); color: var(--ink-1); }
</style>

<script>
  const section = document.getElementById('agenda');
  section?.querySelectorAll<HTMLButtonElement>('[data-track-tab]').forEach((tab, _, all) => {
    tab.addEventListener('click', () => {
      section.dataset.track = tab.dataset.trackTab;
      all.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
    });
  });
</script>

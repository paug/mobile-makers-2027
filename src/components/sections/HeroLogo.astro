<style>
  .hero-logo { display: block; width: 100%; max-width: 1040px; height: auto; margin: 0 auto; overflow: visible; }

  .anim { transform-box: fill-box; transform-origin: center; will-change: transform, opacity; }

  /* Background triangles */
  .tri-left  { animation: fromLeft .9s cubic-bezier(.22,1,.36,1) both; }
  .tri-mid   { animation: fromBottom .9s cubic-bezier(.22,1,.36,1) .15s both; }
  .tri-right { animation: fromRight .9s cubic-bezier(.22,1,.36,1) .3s both; }
  .bg-fill   { animation: fadeIn .6s ease-out .4s both; }

  /* Wordmark */
  .txt-mobile { animation: riseIn .7s cubic-bezier(.22,1,.36,1) .7s both; }
  .txt-makers { animation: riseIn .7s cubic-bezier(.22,1,.36,1) .9s both; }

  /* Mascots */
  .green, .green-hand {
    animation:
      dropIn 1s cubic-bezier(.34,1.56,.64,1) 1.1s both,
      floatGreen 3.4s ease-in-out 2.1s infinite;
  }
  .blue {
    animation:
      slideIn 1s cubic-bezier(.34,1.56,.64,1) 1.35s both,
      floatBlue 3s ease-in-out 2.35s infinite;
  }

  @keyframes fromLeft   { from { transform: translateX(-60%); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes fromRight  { from { transform: translateX(60%);  opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes fromBottom { from { transform: translateY(60%);  opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes fadeIn     { from { opacity: 0; } to { opacity: 1; } }
  @keyframes riseIn     { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }

  @keyframes dropIn  { from { transform: translate(120px, -420px); opacity: 0; } 30% { opacity: 1; } to { transform: none; opacity: 1; } }
  @keyframes slideIn { from { transform: translate(-460px, 160px); opacity: 0; } 30% { opacity: 1; } to { transform: none; opacity: 1; } }

  @keyframes floatGreen { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }
  @keyframes floatBlue  { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(10px); } }

  @media (prefers-reduced-motion: reduce) {
    .anim { animation: none !important; opacity: 1; transform: none; }
  }
</style>

---
import Button from '../ds/Button.astro';
import SectionHead from './SectionHead.astro';
import type { Model } from '../../i18n/model';
const { m } = Astro.props as { m: Model };
const { t } = m;
---
<section id="sponsors" class="mm-section" data-reveal style="margin-top:96px;background:var(--graphite);color:var(--paper-1);padding:clamp(56px,7vw,96px) 0;position:relative;overflow:hidden">
  <div aria-hidden="true" class="hidden desk:block" style="position:absolute;right:-120px;bottom:-240px;width:440px;height:440px;background:linear-gradient(90deg,var(--red-light) 50%,var(--red-dark) 50%);clip-path:polygon(50% 0,100% 100%,0 100%);opacity:.9"></div>
  <div class="mm-wrap" style="position:relative">
    <SectionHead eyebrow={t.sponsorsEyebrow} title={t.sponsorsTitle} lead={t.sponsorsLead} maxWidth={760} inverse />
    <div style="display:flex;flex-direction:column;gap:36px">
      {m.showSponsorTiers && m.tiers.map((tier) => (
        <div style="display:flex;flex-direction:column;gap:14px">
          <div style="display:flex;align-items:center;gap:12px"><span class="mm-label" style="color:var(--cyan-light)">{tier.name}</span><span style="flex:1;height:1px;background:rgba(255,255,255,.1)"></span></div>
          <div style={`display:grid;grid-template-columns:repeat(auto-fit,minmax(min(calc(50% - 6px),${tier.minw}px),1fr));gap:12px`}>
            {tier.tiles.map(() => (
              <div class="mm-logo-tile" style={`--h:${tier.h}px;--ratio:${tier.ratio}`}><span style="font:600 12px/1.3 var(--font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ink-4);text-align:center">{t.logoHere}</span></div>
            ))}
          </div>
        </div>
      ))}
      <div style="display:flex;flex-direction:column;gap:14px">
        <div style="display:flex;align-items:center;gap:12px"><span class="mm-label" style="color:var(--cyan-light)">{t.partnersLabel}</span><span style="flex:1;height:1px;background:rgba(255,255,255,.1)"></span></div>
        <div style="display:flex;flex-wrap:wrap;gap:10px">
          {t.partners.map((p) => <div style="height:56px;min-width:140px;padding:0 20px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;font:500 15px/1 var(--font-display);color:var(--paper-1)">{p}</div>)}
        </div>
      </div>
    </div>
    <div style="margin-top:56px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:24px;align-items:stretch">
      {m.whySponsor.map((w) => (
        <div style="border-top:2px solid var(--red);padding-top:18px;display:flex;flex-direction:column;gap:8px">
          <h3 style="margin:0;font:600 22px/1.2 var(--font-display);color:var(--paper-1)">{w.title}</h3>
          <p style="margin:0;font:400 16px/1.5 var(--font-body);color:var(--paper-3);text-wrap:pretty">{w.body}</p>
        </div>
      ))}
    </div>
    <div style="margin-top:40px;display:flex;flex-wrap:wrap;gap:14px;align-items:center">
      <Button href={m.L.sponsorUrl} target="_blank" size="lg" iconRight="external-link">{t.ctaSponsor}</Button>
      <a href="mailto:contact@mobilemakers.fr" class="mm-mail">contact@mobilemakers.fr</a>
    </div>
  </div>
</section>

<style>
  .mm-logo-tile { width: 100%; height: clamp(56px, calc((50vw - 30px) / var(--ratio)), var(--h)); background: var(--paper-0); display: grid; place-items: center; padding: 16px; box-sizing: border-box; }
  @media (min-width: 1180px) { .mm-logo-tile { height: var(--h); } }
  .mm-mail { font: 500 16px/1 var(--font-mono); color: var(--cyan-light); padding: 12px 4px; display: inline-flex; align-items: center; min-height: 44px; }
  .mm-mail:hover { color: var(--paper-0); }
</style>

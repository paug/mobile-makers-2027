---
// Blog home: list of posts in one language, newest first.
import { buildModel } from '../i18n/model';
import type { Lang } from '../i18n/copy';
import Layout from './Layout.astro';
import { blogHome, formatDate, getPosts, postHref, postSlug } from './blog';

interface Props { lang: Lang }
const { lang } = Astro.props;
const m = buildModel(lang, { fr: blogHome('fr'), en: blogHome('en') });
const posts = await getPosts(lang);
const C = {
  fr: { title: 'Blog', description: "Les actualités de Mobile Makers 2027 : annonces, programme, coulisses de l'organisation.", eyebrow: 'Actualités', read: "Lire l'article" },
  en: { title: 'Blog', description: 'Mobile Makers 2027 news: announcements, schedule and behind the scenes.', eyebrow: 'News', read: 'Read the post' },
}[lang];
---
<Layout m={m} title={`${C.title} · Mobile Makers 2027`} description={C.description}>
  <section class="mm-wrap" style="padding-top:clamp(48px,6vw,80px);padding-bottom:clamp(48px,6vw,80px)">
    <div style="display:flex;flex-direction:column;gap:12px;max-width:720px;margin-bottom:40px">
      <div class="mm-eyebrow">{C.eyebrow}</div>
      <h1 class="mm-h2" style="margin:0;color:var(--ink-1);font-size:clamp(36px,5vw,64px);font-weight:600">{C.title}</h1>
      <p style="margin:0;font:400 19px/1.5 var(--font-body);color:var(--ink-2);text-wrap:pretty">{C.description}</p>
    </div>
    <ul style="list-style:none;margin:0;padding:0;display:grid;gap:16px;max-width:720px">
      {posts.map((p) => (
        <li>
          <a class="mm-postlink" href={postHref(lang, postSlug(p))}>
            <time datetime={p.data.date.toISOString().slice(0, 10)} style="font:500 14px/1.4 var(--font-mono);color:var(--ink-3)">{formatDate(lang, p.data.date)}</time>
            <h2 style="margin:0;font:600 26px/1.15 var(--font-display);letter-spacing:-0.01em;color:var(--ink-1);text-wrap:balance">{p.data.title}</h2>
            <p style="margin:0;font:400 17px/1.5 var(--font-body);color:var(--ink-2);text-wrap:pretty">{p.data.description}</p>
            <span class="mm-postlink__more">{C.read} →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .mm-postlink { display: flex; flex-direction: column; gap: 10px; padding: 24px; background: var(--surface-container-low); text-decoration: none; border-left: 4px solid var(--red); }
  .mm-postlink:hover { background: var(--paper-2); }
  .mm-postlink__more { font: 600 15px/1.4 var(--font-display); color: var(--cyan-text); }
</style>

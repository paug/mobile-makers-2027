---
import type { Lang } from '../i18n/copy';
interface Props { lang: Lang; long?: boolean; hrefs?: Record<Lang, string> }
const { lang, long, hrefs = { fr: '/', en: '/en/' } } = Astro.props;
const label = lang === 'fr' ? 'Langue' : 'Language';
const items = [
  { value: 'fr', href: hrefs.fr, label: long ? 'Français' : 'FR' },
  { value: 'en', href: hrefs.en, label: long ? 'English' : 'EN' },
];
---
<div style="background:var(--paper-1);padding:2px">
  <nav class="mm-tabs" aria-label={label}>
    {items.map((it) => <a class="mm-tab" href={it.href} data-lang-href hreflang={it.value} lang={it.value} aria-current={it.value === lang ? 'page' : undefined}>{it.label}</a>)}
  </nav>
</div>

<script>
  // Keep the section the reader is on when switching language (the hash is only known client side)
  const sync = () => document.querySelectorAll<HTMLAnchorElement>('[data-lang-href]').forEach((a) => { a.hash = location.hash; });
  sync();
  addEventListener('hashchange', sync);
</script>

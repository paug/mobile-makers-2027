---
// Document shell shared by the landing page and the legal pages: head, sticky header, footer.
import '../styles/global.css';
import type { Model } from '../i18n/model';
import Header from './sections/Header.astro';
import Footer from './sections/Footer.astro';

interface Props { m: Model; title: string; description: string }
const { m, title, description } = Astro.props;
const site = (Astro.site ?? new URL('https://mobilemakers.fr')).origin;
const abs = (path: string) => site + path;
const canonical = abs(Astro.url.pathname);
const ogImage = abs('/assets/og/cover.png');
const locale = m.lang === 'fr' ? 'fr_FR' : 'en_US';
const altLocale = m.lang === 'fr' ? 'en_US' : 'fr_FR';
---
<!doctype html>
<html lang={m.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={abs(m.langHrefs.fr)} />
    <link rel="alternate" hreflang="en" href={abs(m.langHrefs.en)} />
    <link rel="alternate" hreflang="x-default" href={abs(m.langHrefs.fr)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mobile Makers 2027" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={m.t.heroLogoAlt} />
    <meta property="og:locale" content={locale} />
    <meta property="og:locale:alternate" content={altLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" href="/fonts/GillSans-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GillSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#282828" />
  </head>
  <body>
    <a href="#main" class="mm-skip">{m.t.skip}</a>
    <div style="min-height:100vh;overflow-x:clip">
      <Header m={m} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Footer m={m} />
    </div>
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>

---
import BlogPost from '../../components/BlogPost.astro';
import { getPosts, postSlug, type Post } from '../../components/blog';

export async function getStaticPaths() {
  return (await getPosts('fr')).map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
---
<BlogPost lang="fr" post={post} />

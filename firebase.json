{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "redirects": [
      {
        "source": "/sponsor-deck",
        "destination": "https://docs.google.com/presentation/d/e/2PACX-1vSYcIiuMHYZ0LLfK1BsuEeblT1rM5KB-3mMEb6K4sfAR-catKvxThGzTj8z27NXRw/pub?start=false&loop=false&delayms=3000",
        "type": 302
      },
      {
        "source": "/tickets",
        "destination": "https://www.billetweb.fr/mobile-makers-2027",
        "type": 302
      },
      {
        "source": "/cfp",
        "destination": "https://conference-hall.io/mobile-makers-2027",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**/*.@(css|js|woff2|otf|png|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      }
    ]
  }
}
